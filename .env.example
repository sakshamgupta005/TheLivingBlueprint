# The Living Blueprint — Server Environment Variables
# Copy this file to .env and provide your API key.
# IMPORTANT: API keys are used server-side only and never exposed to the client bundle.

# Google Gemini API key (Primary Provider)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model selection for primary provider (default: gemini-3.8-flash)
AI_MODEL=gemini-3.8-flash

# Groq API key (Automatic Fallback Provider)
# Obtain a free API key from Groq Console: https://console.groq.com/keys
# Note: Groq free tier is subject to bounded RPM/TPM rate limits (not unlimited).
GROQ_API_KEY=your_groq_api_key_here

# Model selection for fallback provider (default: qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# Cloudflare Workers AI (Optional Tertiary Fallback Provider)
# Obtain an API token and Account ID from Cloudflare Dashboard: https://dash.cloudflare.com/
# Cloudflare Workers AI is attempted only after Gemini and Groq fail with retryable provider errors.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Model selection for tertiary fallback provider (default: @cf/meta/llama-3.3-70b-instruct-fp8-fast)
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

