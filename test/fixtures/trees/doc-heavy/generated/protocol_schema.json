{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProtocolFrame",
  "type": "object",
  "properties": {
    "magic": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{8}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "string"
    }
  },
  "required": [
    "magic",
    "version"
  ]
}